# Copy to .env and fill in values:  cp .env.example .env  (or copy manually on Windows)

# Server
PORT=3000
NODE_ENV=development

# Database (Prisma) — required for migrations and runtime
# Example PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/farmer_advisory?schema=public"

# JWT — use a long random string in production (required in production by env validation)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# OpenWeather (weather module)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Allowed browser origin for CORS (frontend URL)
CORS_ORIGIN=http://localhost:3001
